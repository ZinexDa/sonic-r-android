<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launcher"
    android:fitsSystemWindows="false">

    <!-- Interactive Touch Controls Canvas (Full Screen) -->
    <org.sonicr.android.TouchControlsEditView
        android:id="@+id/touch_controls_edit_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Floating Toolbar (Centered to leave top corners open for Start button) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_retro_panel"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- Row 1: Title + Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_top_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="2"
                    android:text="@string/title_customize_controls"
                    android:textAllCaps="true"
                    android:textColor="#FFE600"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_top_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:text="@string/desc_customize_controls"
                    android:textColor="#82B1FF"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#4D82B1FF" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="80dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_retro_silver"
                android:elevation="2dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:stateListAnimator="@null"
                android:text="@string/btn_reset_default"
                android:textAllCaps="true"
                android:textColor="#263238"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="112dp"
                android:layout_height="32dp"
                android:background="@drawable/btn_retro_play"
                android:elevation="3dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:stateListAnimator="@null"
                android:text="@string/btn_save_exit"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:background="#3382B1FF" />

        <!-- Row 2: Visibility Toggle & Live Opacity Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_show_touch_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:buttonTint="#FFE600"
                android:checked="true"
                android:fontFamily="sans-serif-bold"
                android:text="@string/label_show_touch_controls"
                android:textColor="#E0F2FE"
                android:textSize="12sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="#4D82B1FF" />

            <TextView
                android:id="@+id/text_opacity_label"
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Opacity: 100%"
                android:textColor="#FFE600"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seek_opacity"
                android:layout_width="124dp"
                android:layout_height="24dp"
                android:max="100"
                android:progress="100"
                android:progressTint="#40C4FF"
                android:thumbTint="#40C4FF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Floating Bar (Centered to leave bottom corners open for D-pad & Action buttons) -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="@drawable/card_retro_panel"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/text_selected_label"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:text="@string/label_selected_dpad"
            android:textColor="#E0F2FE"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_scale_minus"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/btn_retro_sega"
            android:fontFamily="sans-serif-black"
            android:stateListAnimator="@null"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seek_scale"
            android:layout_width="136dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:max="70"
            android:progress="30"
            android:progressTint="#FFE600"
            android:thumbTint="#FFE600" />

        <Button
            android:id="@+id/btn_scale_plus"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/btn_retro_sega"
            android:fontFamily="sans-serif-black"
            android:stateListAnimator="@null"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_scale_percent"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-bold"
            android:gravity="end"
            android:text="100%"
            android:textColor="#FFE600"
            android:textSize="12sp" />

    </LinearLayout>

</RelativeLayout>
