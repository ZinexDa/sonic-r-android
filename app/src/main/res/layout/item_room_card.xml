<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_room_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Room Details (Left) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="Sonic Room"
            android:textColor="#FFEB3B"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_room_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_lobby"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="In Lobby"
                android:textColor="#34D399"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_room_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="v0.1.0"
                android:textColor="#64748B"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Player Count (Center-Right) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_player_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="1/4"
            android:textColor="#80D8FF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:text="PLAYERS"
            android:textColor="#64748B"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Join Action Button (Far Right) -->
    <Button
        android:id="@+id/btn_join_room"
        android:layout_width="72dp"
        android:layout_height="34dp"
        android:background="@drawable/btn_primary"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:stateListAnimator="@null"
        android:text="JOIN"
        android:textColor="#261200"
        android:textSize="12sp" />

</LinearLayout>
