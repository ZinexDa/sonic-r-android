<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launcher"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/card_placeholder"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="16dp"
        android:paddingEnd="36dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="@string/title_settings"
            android:textColor="#FFCC00"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="@string/settings_audio_subtitle"
            android:textAllCaps="true"
            android:textColor="#40C4FF"
            android:textSize="11sp" />

        <View
            android:layout_width="60dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="#2640C4FF" />

        <!-- Music Volume Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="6dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_music_volume"
                    android:textColor="#E0F2FE"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/music_volume_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="sans-serif-bold"
                    android:text="80%"
                    android:textColor="#FFCC00"
                    android:textSize="13sp" />
            </RelativeLayout>

            <SeekBar
                android:id="@+id/seek_music_volume"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:max="100"
                android:progress="80"
                android:progressTint="#FFCC00"
                android:thumbTint="#FFCC00" />
        </LinearLayout>

        <!-- Sound Effects Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_sfx_volume"
                    android:textColor="#E0F2FE"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/sfx_volume_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="sans-serif-bold"
                    android:text="100%"
                    android:textColor="#4ADE80"
                    android:textSize="13sp" />
            </RelativeLayout>

            <SeekBar
                android:id="@+id/seek_sfx_volume"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:max="100"
                android:progress="100"
                android:progressTint="#4ADE80"
                android:thumbTint="#4ADE80" />
        </LinearLayout>

        <!-- Touch Controls Section Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:background="#1A40C4FF" />

        <TextView
            android:id="@+id/controls_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="@string/settings_controls_subtitle"
            android:textAllCaps="true"
            android:textColor="#40C4FF"
            android:textSize="11sp" />

        <!-- Control Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_customize_controls"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:stateListAnimator="@null"
                android:text="@string/btn_customize_controls"
                android:textColor="#40C4FF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_reset_controls"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:stateListAnimator="@null"
                android:text="@string/btn_reset_controls"
                android:textColor="#90CAF9"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bottom Action Row: About & Back -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btn_about"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"
                android:text="@string/btn_about"
                android:textColor="#E0F2FE"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"
                android:text="@string/btn_back"
                android:textColor="#E0F2FE"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
